{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phuebus",
  "version": "0.1.0",
  "identifier": "com.phuebus.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Phuebus Live Projection Engine",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "build": {
    "beforeDevCommand": "npm run client:dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:5173"
  }
}
